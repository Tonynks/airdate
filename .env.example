# Get a free key at https://www.themoviedb.org/settings/api (v3 auth key, not the v4 bearer token)
TMDB_API_KEY=your_tmdb_api_key_here

# Used ONLY the very first time the app starts, to create your initial account
# (from here on, accounts/passwords are managed inside the app itself, under
# the "Accounts" button — these two env vars have no effect after that).
APP_PASSWORD=changeme
ACCOUNT_NAME=tvman

# Random string used to sign the session cookie - change this
SESSION_SECRET=change-this-to-something-random

# Optional. Only used as a contact address in the Web Push protocol (some
# push services may use it to reach you about your server, e.g. if it's
# misbehaving) — doesn't need to be a real monitored inbox.
PUSH_CONTACT_EMAIL=admin@example.com
